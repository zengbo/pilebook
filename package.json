{
  "name": "pilebook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 4471",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4471",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:migrate": "wrangler d1 migrations apply pilebook --local",
    "db:seed": "node --experimental-strip-types scripts/seed.mjs",
    "setup": "node scripts/setup.mjs",
    "cf-typegen": "wrangler types"
  }
}
